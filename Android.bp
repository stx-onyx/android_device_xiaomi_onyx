soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel",
        "device/xiaomi/onyx/power-libperfmgr",
        "hardware/qcom-caf/common/libqti-perfd-client",
        "hardware/xiaomi"
    ],
}

install_symlink {
    name: "firmware_wlanmdsp.otaupdate_symlink",
    vendor: true,
    installed_location: "firmware/wlanmdsp.otaupdate",
    symlink_target: "/data/vendor/firmware/wlanmdsp.mbn",
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/wcn7750/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/wlan/wlan_mac.bin",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/wcn7750/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/wcn7750/WCNSS_qcom_cfg.ini",
}

mkdir {
    name: "vendor_modem_firmware_mountpoint",
    dir: "modem_firmware",
    vendor: true,
}

// CneApp (vendor blob) loads libvndfwk_detect_jni.qti_vendor, which
// LineageOS builds in core-utils-vendor. On StatiX the same JNI library is
// hardware/qcom-caf/common's libvndfwk_detect_jni.qti, so point CneApp at it.
install_symlink {
    name: "CneApp.libvndfwk_detect_jni.qti_vendor_symlink",
    vendor: true,
    installed_location: "app/CneApp/lib/arm64/libvndfwk_detect_jni.qti_vendor.so",
    symlink_target: "/vendor/lib64/libvndfwk_detect_jni.qti.so",
    required: ["libvndfwk_detect_jni.qti"],
}
