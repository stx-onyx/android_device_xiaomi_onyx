# loc_launcher execs xtra-daemon/lowi-server but never transitions, so both silently failed to start.
type_transition vendor_location vendor_location_xtra_daemon_exec:process vendor_location_xtra_daemon;
type_transition vendor_location vendor_location_lowi_server_exec:process vendor_location_lowi_server;

allow vendor_location vendor_location_xtra_daemon:process { transition siginh rlimitinh noatsecure };
allow vendor_location vendor_location_lowi_server:process { transition siginh rlimitinh noatsecure };
allow vendor_location vendor_location_xtra_daemon_exec:file { execute read open getattr map };
allow vendor_location vendor_location_lowi_server_exec:file { execute read open getattr map };
allow vendor_location_xtra_daemon vendor_location_xtra_daemon_exec:file entrypoint;
allow vendor_location_lowi_server vendor_location_lowi_server_exec:file entrypoint;

# The exec handoff passes loc_launcher's fds (binary + QMI sockets) to the child.
allow vendor_location_xtra_daemon vendor_location:fd use;
allow vendor_location_lowi_server vendor_location:fd use;
