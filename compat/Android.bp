// Shared protobuf 21.12 for the blobs built against it (liboischannel and
// others). StatiX only has a static library by this name, which the vendor
// modules can't link against; this one, in the device namespace, takes
// precedence for them.
cc_prebuilt_library_shared {
    name: "libprotobuf-cpp-full-21.12-vendorcompat",
    stem: "libprotobuf-cpp-full-21.12",
    vendor: true,
    strip: {
        none: true,
    },
    shared_libs: [
        "libc++",
        "liblog",
        "libz",
    ],
    target: {
        android_arm64: {
            srcs: ["libprotobuf/arm64/libprotobuf-cpp-full-21.12.so"],
        },
    },
    compile_multilib: "64",
}

cc_prebuilt_library_shared {
    name: "libprotobuf-cpp-lite-21.12-vendorcompat",
    stem: "libprotobuf-cpp-lite-21.12",
    vendor: true,
    strip: {
        none: true,
    },
    shared_libs: [
        "libc++",
        "liblog",
    ],
    target: {
        android_arm64: {
            srcs: ["libprotobuf/arm64/libprotobuf-cpp-lite-21.12.so"],
        },
    },
    compile_multilib: "64",
}
