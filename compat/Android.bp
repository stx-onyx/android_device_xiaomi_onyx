// Libraries the vendor blobs are patched to need (see extract-files.py)
// that StatiXOS's hardware/statix/compat doesn't have. Taken from
// LineageOS's hardware/lineage/compat.

cc_library_shared {
    name: "libaudioutils_shim",
    vendor: true,
    srcs: ["libaudioutils/mutex.cpp"],
    shared_libs: ["libaudioutils"],
}

cc_prebuilt_library_shared {
    name: "libtinyxml2-v34",
    vendor: true,
    strip: {
        none: true,
    },
    shared_libs: [
        "libc",
        "libc++",
        "libdl",
        "liblog",
        "libm",
    ],
    target: {
        android_arm64: {
            srcs: ["libtinyxml2/arm64/libtinyxml2-v34.so"],
        },
    },
    compile_multilib: "64",
}
